# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real secrets, even development ones.

POSTGRES_PASSWORD=jusoor_dev_only

# Generate with: openssl rand -base64 64
# Must be at least 32 bytes for HS256. This is a LOCAL DEV key only —
# staging/production read this from Azure Key Vault, never from a file,
# per spec §22.
JWT_SIGNING_KEY=replace-with-a-generated-64-byte-random-string

# Development-only demo newsroom login for the CMS (optional).
# Pick your own local values; never reuse a real password. Blank = no account created.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
DEV_SEED_ROLE=ManagingEditor

# Optional separate local demo users by newsroom position.
# Set an email and a strong unique password for each position you want to try.
# ASP.NET Identity hashes passwords before storing them in PostgreSQL.
# Development-only; do not use these settings for staging or production.
DEV_SEED_REPORTER_EMAIL=
DEV_SEED_REPORTER_PASSWORD=
DEV_SEED_REPORTER_NAME=مراسل تجريبي
DEV_SEED_RESEARCHER_EMAIL=
DEV_SEED_RESEARCHER_PASSWORD=
DEV_SEED_RESEARCHER_NAME=باحث تجريبي
DEV_SEED_AI_EDITOR_EMAIL=
DEV_SEED_AI_EDITOR_PASSWORD=
DEV_SEED_AI_EDITOR_NAME=محرر ذكاء اصطناعي تجريبي
DEV_SEED_COPY_EDITOR_EMAIL=
DEV_SEED_COPY_EDITOR_PASSWORD=
DEV_SEED_COPY_EDITOR_NAME=مدقق لغوي تجريبي
DEV_SEED_SENIOR_EDITOR_EMAIL=
DEV_SEED_SENIOR_EDITOR_PASSWORD=
DEV_SEED_SENIOR_EDITOR_NAME=محرر أول تجريبي
DEV_SEED_MANAGING_EDITOR_EMAIL=
DEV_SEED_MANAGING_EDITOR_PASSWORD=
DEV_SEED_MANAGING_EDITOR_NAME=مدير تحرير تجريبي
DEV_SEED_EDITOR_IN_CHIEF_EMAIL=
DEV_SEED_EDITOR_IN_CHIEF_PASSWORD=
DEV_SEED_EDITOR_IN_CHIEF_NAME=رئيس تحرير تجريبي
DEV_SEED_FACT_CHECKER_EMAIL=
DEV_SEED_FACT_CHECKER_PASSWORD=
DEV_SEED_FACT_CHECKER_NAME=مدقق حقائق تجريبي
DEV_SEED_SEO_EDITOR_EMAIL=
DEV_SEED_SEO_EDITOR_PASSWORD=
DEV_SEED_SEO_EDITOR_NAME=محرر SEO تجريبي
DEV_SEED_CRISIS_EDITOR_EMAIL=
DEV_SEED_CRISIS_EDITOR_PASSWORD=
DEV_SEED_CRISIS_EDITOR_NAME=محرر أزمات تجريبي
DEV_SEED_SYSTEM_ADMIN_EMAIL=
DEV_SEED_SYSTEM_ADMIN_PASSWORD=
DEV_SEED_SYSTEM_ADMIN_NAME=مسؤول نظام تجريبي

# Local-dev field-encryption key (docker-compose REQUIRES it; the API uses it
# to encrypt sensitive fields at rest). Generate with: openssl rand -base64 32
# LOCAL DEV ONLY — staging/production must use Azure Key Vault, never a file.
FIELD_ENCRYPTION_LOCAL_KEY=

# Editorial media storage (Slice 22). The service-role key is server-side only:
# never add it to frontend env, NEXT_PUBLIC_*, source control, or a ZIP delivery.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=jusoor-media
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the website, used for canonical URLs, Schema.org data and
# sitemaps (Slice 18). REQUIRED in staging/production; without it those are
# disabled and /sitemap.xml answers 503. Defaults to http://localhost:3000 in dev.
SITE_URL=http://localhost:3000
