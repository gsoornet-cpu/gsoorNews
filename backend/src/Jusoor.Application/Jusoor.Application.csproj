<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Jusoor.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions and
         Microsoft.Extensions.Logging.Abstractions were removed here — they
         were pinned to 9.0.0 and caused NU1605 downgrade errors once EF
         Core (below) pulled in 10.x transitively. Neither was actually
         needed as a *direct* reference: IServiceCollection/AddMediatR/
         AddValidatorsFromAssembly already bring them in transitively at
         whatever version the rest of the graph needs. Letting NuGet resolve
         them instead of pinning a stale floor is the fix, not a shortcut. -->
    <!-- IApplicationDbContext exposes DbSet<T> — that's the provider-agnostic
         IQueryable abstraction, not a Postgres/Npgsql dependency, so this
         does not violate the Application layer's "no infrastructure"
         boundary the same way referencing Npgsql or the concrete
         ApplicationDbContext would. This is the same pattern used by
         Jason Taylor's widely-used Clean Architecture template for exactly
         this reason. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Added for Slice 5 (Relevance Engine v1): DependencyInjection.cs now
         binds RelevanceOptions from IConfiguration via
         services.Configure<TOptions>(IConfigurationSection). That overload —
         and the IConfiguration type itself — live in
         Microsoft.Extensions.Options.ConfigurationExtensions, not in
         Microsoft.Extensions.Options (which only has the delegate-based
         Configure<TOptions>(Action<TOptions>) overload, already available
         transitively). Nothing else in this project referenced IConfiguration
         before this slice, so this was a genuine missing reference, not a
         version pin. Pinned to 10.0.11 to match the Microsoft.Extensions.
         Configuration.Abstractions version Jusoor.Infrastructure.csproj
         already pins directly — same "avoid NU1605 downgrade" reasoning the
         comment above already gives, just applied consistently across the
         solution rather than introducing a second, lower floor. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jusoor.Domain\Jusoor.Domain.csproj" />
  </ItemGroup>

</Project>