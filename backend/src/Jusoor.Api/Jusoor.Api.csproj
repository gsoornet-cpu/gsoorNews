<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Jusoor.Api</RootNamespace>
    <UserSecretsId>jusoor-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- 6.9.0 only supports up to net8/net9 and would have failed the same
         way as the EF Core packages did — bumped to the net10-compatible line. -->
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.0" />
    <!-- Swashbuckle 10.2.0 transitively pulls Microsoft.OpenApi 2.4.1, which
         has a known high-severity stack-overflow DoS on circular schema
         references (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451). 2.7.5 is the
         patched 2.x release (staying on the 2.x line deliberately —
         Swashbuckle 10.2.0 expects the 2.x API surface; 3.x has breaking
         changes Swashbuckle hasn't picked up yet). Direct override, same
         approach used in the upstream fixes for this CVE. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jusoor.Application\Jusoor.Application.csproj" />
    <ProjectReference Include="..\Jusoor.Infrastructure\Jusoor.Infrastructure.csproj" />
  </ItemGroup>

</Project>
